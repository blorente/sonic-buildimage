load("//:defs.bzl", "PROTOC_TOOLS", "protoc_cmd")

package(default_visibility = ["//visibility:public"])

# libprotobuf 3.21.12: headers from libprotobuf-dev, the shared object from
# libprotobuf32t64. Linking against the versioned `.so` rather than the `.a`
# keeps the import in the binary, matching what the Make build produces.
alias(
    name = "libprotobuf",
    actual = "@libprotobuf_dev//:libprotobuf",
)

# protobuf's headers without its shared object, for a target that compiles
# against protobuf but leaves the symbols for its own consumer to resolve.
alias(
    name = "libprotobuf_headers",
    actual = "@libprotobuf_dev//:libprotobuf_headers",
)

alias(
    name = "well_known_protos",
    actual = "@libprotobuf_dev//:well_known_protos",
)

# Smoke test: the protoc we run must be the version the base layer ships.
genrule(
    name = "protoc_version",
    outs = ["protoc_version.txt"],
    cmd = protoc_cmd("--version") + " > $@",
    tools = PROTOC_TOOLS,
)
